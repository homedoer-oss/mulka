+/*
+ * Mulka: fail-closed egress while an HTTP proxy is configured
+ * (slirp->http_proxy_on). TCP is expected to go through the proxy. Any socket
+ * slirp opens directly (UDP, the ICMP echo socket, TCP the proxy declined) may
+ * then only target host loopback (10.0.2.2, a loopback DNS server) or, on
+ * port 53, the DNS server a guest 10.0.2.3+ address was translated to.
+ * |host_addr| is the address after sotranslate_out().
+ */
+static bool sockaddr_is_loopback(const struct sockaddr_storage *addr)
+{
+    switch (addr->ss_family) {
+    case AF_INET:
+        return (ntohl(((const struct sockaddr_in *)addr)->sin_addr.s_addr) >> 24)
+               == 127;
+    case AF_INET6: {
+        const uint8_t *b = ((const struct sockaddr_in6 *)addr)->sin6_addr.s6_addr;
+        static const uint8_t zeros[10];
+        if (memcmp(b, zeros, 10) != 0) {
+            return false;
+        }
+        /* ::1 or ::ffff:127.x.y.z */
+        return (b[10] == 0 && b[11] == 0 && b[12] == 0 && b[13] == 0 &&
+                b[14] == 0 && b[15] == 1) ||
+               (b[10] == 0xff && b[11] == 0xff && b[12] == 127);
+    }
+    default:
+        return false;
+    }
+}
+
+static bool so_is_guest_dns(const struct socket *so)
+{
+    Slirp *slirp = so->slirp;
+
+    switch (so->so_ffamily) {
+    case AF_INET:
+        return so->so_fport == htons(53) &&
+               (so->so_faddr.s_addr & slirp->vnetwork_mask.s_addr) ==
+                   slirp->vnetwork_addr.s_addr &&
+               so->so_faddr.s_addr != slirp->vhost_addr.s_addr;
+    case AF_INET6:
+        return so->so_fport6 == htons(53) &&
+               in6_equal_net(&so->so_faddr6, &slirp->vprefix_addr6,
+                             slirp->vprefix_len) &&
+               !in6_equal_mach(&so->so_faddr6, &slirp->vhost_addr6,
+                               slirp->vprefix_len);
+    default:
+        return false;
+    }
+}
+
+bool slirp_proxy_egress_allowed(const struct socket *so,
+                                const struct sockaddr_storage *host_addr)
+{
+    if (!so->slirp->http_proxy_on || sockaddr_is_loopback(host_addr)) {
+        return true;
+    }
+    return so_is_guest_dns(so);
+}
