root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,xml,csproj,props,slnx,xaml,md}]
indent_size = 2

[*.{sln,slnx,csproj,props,ps1,cmd,bat}]
end_of_line = crlf

[*.md]
trim_trailing_whitespace = false
